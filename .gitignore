# Brain checkpoints (large / regenerable) — keep directory, ignore weights
output/*.brain
output/*.brain.*
output/*.brain.tmp.*
output/*.brain.lock
output/logs/
*.brain
*.brain.*
*.brain.lock

# Keep placeholder + default fight brain when present
!output/.gitkeep
!output/spaz_fight.brain


# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv*/

# Ballistica build trees if someone clones engine beside this repo
ballistica/build/
ballistica/.cache/
ballistica/.venv/

# Secrets / local
.env
.env.*
*.pem
*credentials*
.DS_Store
